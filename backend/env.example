# --- App ---
APP_NAME=anti-procrastination
APP_ENV=development
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173

# --- Auth ---
JWT_SECRET=change-me
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# --- Database ---
# Dev (sqlite):
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Prod example:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/antiproc

# --- LLM ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_STEPS=8

# --- Payments ---
PAYMENT_PROVIDER=mock          # mock | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FORFEIT_DESTINATION=burn       # platform | charity | burn

# --- Scheduler ---
SCHEDULER_TICK_SECONDS=10
