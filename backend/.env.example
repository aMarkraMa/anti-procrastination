# Settings priority: .env (committed defaults) < .env.local (local secrets, git-ignored).
# Put OPENAI_API_KEY in backend/.env.local

# --- App ---
APP_NAME=anti-procrastination
APP_ENV=development
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:4200,http://localhost:5173

# --- LLM ---
# OPENAI_API_KEY=  # put your key in backend/.env.local
LLM_MODEL=gpt-4o-mini
LLM_MAX_STEPS=8
LLM_TEMPERATURE=0.4
LLM_REQUEST_TIMEOUT_SECONDS=60

# Optional fallback provider — used automatically if OpenAI fails.
# GEMINI_API_KEY=  # put your key in backend/.env.local
GEMINI_MODEL=gemini-2.0-flash

# Comma-separated provider chain (left to right). Examples:
#   openai,gemini   — try OpenAI first, fall back to Gemini.
#   gemini,openai   — try Gemini first.
#   openai          — disable Gemini even if its key is set.
LLM_PROVIDER_ORDER=openai,gemini
